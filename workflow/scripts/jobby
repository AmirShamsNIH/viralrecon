#!/usr/bin/env python3
# -*- coding: UTF-8 -*-

"""jobby: display past job information across schedulers. From NIAID NCBR (OpenOmics),
a public-domain United States Government Work. Usage: jobby [OPTIONS] JOB_ID [JOB_ID ...]"""

from __future__ import print_function, division
import sys, os, subprocess, math, re
from subprocess import PIPE
import argparse
import textwrap
import tempfile

__version__ = 'v0.2.1'
__authors__ = 'Skyler Kuhn'
__email__ = 'skyler.kuhn@nih.gov'
__home__ = os.path.dirname(os.path.abspath(__file__))
_name = os.path.basename(sys.argv[0])
_description = 'Will take your job(s)... and display their information!'


class Colors():
    """ANSI escape sequences for styling terminal text; end a styled string with
    Colors.end."""
    end = '\33[0m'
    bold = '\33[1m'
    italic = '\33[3m'
    url = '\33[4m'
    blink = '\33[5m'
    higlighted = '\33[7m'
    black = '\33[30m'
    red = '\33[31m'
    green = '\33[32m'
    yellow = '\33[33m'
    blue = '\33[34m'
    pink = '\33[35m'
    cyan = '\33[96m'
    white = '\33[37m'
    bg_black = '\33[40m'
    bg_red = '\33[41m'
    bg_green = '\33[42m'
    bg_yellow = '\33[43m'
    bg_blue = '\33[44m'
    bg_pink = '\33[45m'
    bg_cyan = '\33[46m'
    bg_white = '\33[47m'


def which(cmd, path=None):
    """Return True if cmd is an executable in path (default: $PATH)."""
    if path is None:
        path = os.environ["PATH"].split(os.pathsep)

    for prefix in path:
        filename = os.path.join(prefix, cmd)
        executable = os.access(filename, os.X_OK)
        is_not_directory = os.path.isfile(filename)
        if executable and is_not_directory:
            return True

    return False


def err(*message, **kwargs):
    """Print args to standard error; kwargs are passed to print()."""
    print(*message, file=sys.stderr, **kwargs)



def fatal(*message, **kwargs):
    """Print args to standard error and exit with code 1."""
    err(*message, **kwargs)
    sys.exit(1)


def get_toolkit(tool_list):
    """Return the first tool from the ordered tool_list that is found in $PATH."""
    best_choice = None
    for exe in tool_list:
        if which(exe):
            best_choice = exe
            break

    if not best_choice:
        err(
            'Error: Did not find any tools to get job information!'
        )
        fatal(
            'Expected one of the following tools to be in $PATH:'
            '\t{0}'.format(tool_list)
        )

    return best_choice


def add_missing(linelist, insertion_dict):
    """Insert values into linelist at zero-based indices from insertion_dict, e.g.
    add_missing([0,1,2,3,4], {3:['+','++'], 1:'-', 4:'@'})"""
    # Insert from the largest index down so earlier offsets do not shift.
    tmp_list = linelist
    indices = sorted(list(insertion_dict.keys()), reverse=True)
    for i in indices:
        if isinstance(insertion_dict[i], list):
            for v in reversed(insertion_dict[i]):
                tmp_list.insert(i, v)
        else:
            tmp_list.insert(i, insertion_dict[i])
    return tmp_list


def convert_size(size_bytes):
    """Convert bytes to a human readable size."""
    size_name = (
        "B", "KiB", "MiB",
        "GiB", "TiB", "PiB",
        "EiB", "ZiB", "YiB"
    )
    if size_bytes == 0:
        return "0B"
    i = int(math.floor(math.log(size_bytes, 1024)))
    p = math.pow(1024, i)
    s = round(size_bytes / p, 2)
    return "{0}{1}".format(s, size_name[i])


def to_bytes(size):
    """Convert a human readable size unit into bytes.
    Returns None if cannot convert/parse provided size."""
    size2bytes = {
        "b":1, "bytes":1, "byte":1,
        "k":1024, "kib":1024, "kb":1000,
        "m": 1024**2, "mib": 1024**2, "mb": 1000**2,
        "g": 1024**3, "gib": 1024**3, "gb": 1000**3,
        "t": 1024**4, "tib": 1024**4, "tb": 1000**4,
        "p": 1024**5, "pib": 1024**5, "pb": 1000**5,
        "e": 1024**6, "eib": 1024**6, "eb": 1000**6,
        "z": 1024**7, "zib": 1024**7, "zb": 1000**7,
        "y": 1024**8, "yib": 1024**8, "yb": 1000**8
    }

    size = size.replace(' ','')
    match = re.search('(?P<size>[0-9.]+)(?P<units>[a-zA-Z]+)$', size)

    if match:
        human_units = match.group('units').lower()
        human_units = human_units.lstrip().rstrip()
        scaling_factor = size2bytes[human_units]
        bytes = int(math.ceil(scaling_factor * float(match.group('size'))))
    else:
        return None

    return bytes



def sge(jobs, threads, tmp_dir):
    """Display SGE job information (not implemented)."""
    pass


def uge(jobs, threads, tmp_dir):
    """Display UGE job information (not implemented)."""
    pass


def dashboard_cli(jobs, threads=1, tmp_dir=None):
    """Biowulf job information via dashboard_cli, which HPC staff recommend over sacct
    for performance."""
    fields = [
        "jobid","jobname",
        "state","partition",
        "gres","cpus","mem",
        "cpu_max","mem_max",
        "timelimit","queued_time",
        "start_time","end_time",
        "elapsed_time","nodelist",
        "user", "std_out", "std_err",
        "work_dir"
    ]

    # --tab does not print a header, so print it here
    print('\t'.join(fields))
    cmd = subprocess.run(
        'dashboard_cli jobs --archive --tab --joblist {0} --fields {1}'.format(
            ','.join(jobs),
            ','.join(fields)
        ),
        stdout=PIPE,
        stderr=PIPE,
        universal_newlines=True,
        shell=True
    )

    if cmd.returncode != 0:
        err("\nError: Failed to get job information with 'dashboard_cli'!")
        err('Please see error message below:')
        fatal('  ', cmd.stderr)

    print(cmd.stdout.rstrip('\n'))


def get_slurm_version():
    """Return SLURM's [major, minor, patch] version from `sacct -V`."""
    cmd = subprocess.run(
        'sacct -V',
        stdout=PIPE,
        stderr=PIPE,
        universal_newlines=True,
        shell=True
    )  # slurm 21.08.8-2
    sematic_version = cmd.stdout.rstrip('\n').split(' ')[-1]  # 21.08.8-2
    sematic_version = sematic_version.split('-')[0].split('.')  # ['21', '08', '8']
    sematic_version = [int(v) for v in sematic_version]  # [21, 8, 8]

    return sematic_version


def sacct(jobs, threads=1, tmp_dir=None):
    """Generic SLURM job information via sacct, portable across clusters. Max memory
    comes from the MaxRSS field of the $SLURM_JOBID.batch lines."""
    header = [
        "jobid","jobname","state","partition",
        "gres","cpus","mem","cpu_max","mem_max",
        "timelimit","queued_time","start_time",
        "end_time","elapsed_time","nodelist",
        "user","std_out","std_err", "work_dir"
    ]
    fields = [
        "jobid", "jobname",
        "state", "partition",
        "reqtres", "alloccpus",
        "reqmem", "maxrss",
        "timelimit", "reserved",
        "start", "end",
        "elapsed", "nodelist",
        "user", "workdir"
    ]

    major, minor, patch = get_slurm_version()
    if major >= 23:
        # SLURM 23 renamed the Reserved field to Planned.
        fields = [
            "jobid", "jobname",
            "state", "partition",
            "reqtres", "alloccpus",
            "reqmem", "maxrss",
            "timelimit", "planned",
            "start", "end",
            "elapsed", "nodelist",
            "user", "workdir"
        ]

    # Missing std_out and std_err
    missing_fields = {15:['-','-']}
    print('\t'.join(header))
    cmd = subprocess.run(
        "sacct -j {0} -P --delimiter $'\\t' --format={1}".format(
            ','.join(jobs),
            ','.join(fields)
        ),
        stdout=PIPE,
        stderr=PIPE,
        universal_newlines=True,
        shell=True
    )

    if cmd.returncode != 0:
        err("\nError: Failed to get job information with 'sacct'!")
        err('Please see error message below:')
        fatal('  ', cmd.stderr)

    j2m = {}
    job_information = cmd.stdout.rstrip('\n').split('\n')
    for i, line in enumerate(job_information):
        if i < 1:
            # skip over header
            continue
        linelist = line.lstrip().rstrip().split('\t')
        if linelist[0].endswith('.batch'):
            jobid = linelist[0].strip().split('.')[0]
            maxmem = linelist[7].replace(' ', '')
            mem_bytes = to_bytes(maxmem)
            if not mem_bytes:
                j2m[jobid] = '-'
                continue

            human_readable_mem = convert_size(mem_bytes)
            j2m[jobid] = human_readable_mem

    for i, line in enumerate(job_information):
        if i < 1:
            # skip over header
            continue
        linelist = line.lstrip().rstrip().split('\t')
        jobid = linelist[0].strip()
        if '.' not in jobid:
            try:
                max_mem = j2m[jobid]
            except KeyError:
                # Job may still be running or not completed
                max_mem = '-'
            status = linelist[2].split(' ')[0]
            linelist[2] = status
            missing_fields[8] = max_mem
            linelist = add_missing(linelist, missing_fields)
            linelist = [info if info else '-' for info in linelist]
            print('\t'.join(linelist))


def slurm(jobs, threads, tmp_dir):
    """Display SLURM job information."""
    tool_priority = ['dashboard_cli', 'sacct']
    job_tool = get_toolkit(tool_priority)
    # eval() turns the tool name into its handler function
    eval(job_tool)(jobs=jobs, threads=threads, tmp_dir=tmp_dir)


def jobby(args):
    """Dispatch to the handler for the requested job scheduler."""
    abstract_handler = None
    job_ids = args.JOB_ID
    scheduler = args.scheduler
    threads = args.threads
    tmp_dir = args.tmp_dir

    if scheduler == 'slurm':
        abstract_handler = slurm
    else:
        fatal(
            'Error: "{0}" is an unsupported job scheduler!'.format(scheduler)
        )

    abstract_handler(
        jobs=job_ids,
        threads=threads,
        tmp_dir=tmp_dir
    )


def parsed_arguments(name, description):
    """Parse command-line arguments. Help for required options is suppressed and kept
    in the usage statement, so update it when adding an argument."""
    c = Colors
    styled_name = "{0}{1}{2}{3}{4}".format(
        c.bold, c.bg_black,
        c.cyan, name, c.end
    )
    description = "{0}{1}{2}".format(c.bold, description, c.end)
    temp = tempfile.gettempdir()

    usage_statement = textwrap.dedent("""\
        {0}: {1}

        {3}{4}Synopsis:{5}
          $ {2} [--version] [--help] \\
                [--scheduler {{slurm | ...}}] \\
                [--threads THREADS] [--tmp-dir TMP_DIR] \\
                <JOB_ID [JOB_ID ...]>

        {3}{4}Description:{5}
          {2} displays information about past jobs in one tab-separated
        format, whichever scheduler ran them. On SLURM it uses dashboard_cli
        when available and falls back to sacct.

        {3}{4}Required Positional Arguments:{5}
          <JOB_ID [JOB_ID ...]>
                                Identifiers of past jobs, separated by spaces.

        {3}{4}Options:{5}
          -s, --scheduler {{slurm | ...}}
                                @Default: slurm
                                Job scheduler of the target system. Only
                                slurm is supported.
                                  @Example: --scheduler slurm
          -n, --threads THREADS
                                @Default: 1
                                Accepted for compatibility; currently unused.
                                  @Example: --threads 8
          -t, --tmp-dir TMP_DIR
                                @Default: {7}/
                                Accepted for compatibility; currently unused.
                                  @Example: --tmp-dir '/scratch/$USER/'

          -h, --help            Shows help and usage information and exits.
                                  @Example: --help

          -v, --version         Displays version information and exits.
                                  @Example: --version
        """.format(styled_name, description, name, c.bold, c.url, c.end, c.italic, temp))

    run_epilog = textwrap.dedent("""\
        {2}{3}Example:{4}
        ./jobby -s slurm  -n 4 18627542 13627516 58627597 48627666

        {2}{3}Version:{4}
          {1}
        """.format(name, __version__, c.bold, c.url, c.end))

    parser = argparse.ArgumentParser(
        usage=argparse.SUPPRESS,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=usage_statement,
        epilog=run_epilog,
        add_help=False
    )

    parser.add_argument(
        'JOB_ID',
        nargs='+',
        help=argparse.SUPPRESS
    )

    parser.add_argument(
        '-v', '--version',
        action='version',
        version='%(prog)s {}'.format(__version__),
        help=argparse.SUPPRESS
    )

    parser.add_argument(
        '-h', '--help',
        action='help',
        help=argparse.SUPPRESS
    )

    parser.add_argument(
        '-t', '--tmp-dir',
        type=str,
        required=False,
        default=temp,
        help=argparse.SUPPRESS
    )

    parser.add_argument(
        '-n', '--threads',
        type=int,
        required=False,
        default=1,
        help=argparse.SUPPRESS
    )

    parser.add_argument(
        '-s', '--scheduler',
        type=lambda s: str(s).lower(),
        required=False,
        default="slurm",
        choices=['slurm'],
        help=argparse.SUPPRESS
    )

    parser.set_defaults(func=jobby)
    args = parser.parse_args()

    return args


def main():
    if len(sys.argv) == 1:
        fatal('Invalid usage: {} [-h] [--version] ...'.format(_name))

    args = parsed_arguments(
        name=_name,
        description=_description
    )

    err('{} ({})'.format(_name, __version__))
    args.func(args)


if __name__ == '__main__':
    main()
